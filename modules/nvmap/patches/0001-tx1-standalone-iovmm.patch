diff --git a/drivers/video/tegra/nvmap/nvmap_init.c b/drivers/video/tegra/nvmap/nvmap_init.c
index 0cf5abd..db18d47 100644
--- a/drivers/video/tegra/nvmap/nvmap_init.c
+++ b/drivers/video/tegra/nvmap/nvmap_init.c
@@ -1047,6 +1047,19 @@ static int __init nvmap_init_driver(void)
 		goto fail;
 	}
 
+#ifdef NVMAP_LOADABLE_MODULE
+	if (!nvmap_is_carveout_node_present()) {
+		pdev = platform_device_register_simple("tegra-carveouts", -1,
+						       NULL, 0);
+		if (IS_ERR(pdev)) {
+			e = PTR_ERR(pdev);
+			pdev = NULL;
+			platform_driver_unregister(&nvmap_driver);
+			nvmap_heap_deinit();
+		}
+	}
+#endif
+
 fail:
 	return e;
 }
@@ -1060,7 +1073,7 @@ fs_initcall(nvmap_init_driver);
 static void __exit nvmap_exit_driver(void)
 {
 #ifdef NVMAP_LOADABLE_MODULE
-	if (!nvmap_is_carveout_node_present())
+	if (pdev)
 		platform_device_unregister(pdev);
 #endif /* NVMAP_LOADABLE_MODULE */
 	platform_driver_unregister(&nvmap_driver);
diff --git a/drivers/video/tegra/nvmap/nvmap_ioctl.c b/drivers/video/tegra/nvmap/nvmap_ioctl.c
index 2913540..cfedeaa 100644
--- a/drivers/video/tegra/nvmap/nvmap_ioctl.c
+++ b/drivers/video/tegra/nvmap/nvmap_ioctl.c
@@ -1120,6 +1120,9 @@ int nvmap_ioctl_get_available_heaps(struct file *filp, void __user *arg)
 
 	for (i = 0; i < nvmap_dev->nr_carveouts; i++)
 		op.heaps |= nvmap_dev->heaps[i].heap_bit;
+	/* The Debian TX1 device tree has no NVIDIA carveout node. System
+	 * pages remain available through the IOVMM allocation path. */
+	op.heaps |= NVMAP_HEAP_IOVMM;
 
 	if (copy_to_user(arg, &op, sizeof(op))) {
 		pr_err("copy_to_user failed\n");
