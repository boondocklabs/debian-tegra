@@ -15,6 +15,7 @@
 #include <linux/reset.h>
 #ifdef NVGPU_TX1_PORT
 #include <linux/regulator/consumer.h>
+#include <linux/mutex.h>
 #include <soc/tegra/pmc.h>
 #endif
 #include <nvgpu/vpr.h>
@@ -880,8 +881,62 @@
 	struct clk *gpu;
 	struct clk *ref;
 	struct clk *pwr;
+	struct mutex rate_lock;
 	bool powered;
 } tx1_power;
+
+static unsigned long tx1_gpu_freqs[] = {
+	76800000, 153600000, 230400000, 307200000, 384000000,
+	460800000, 537600000, 614400000, 691200000, 768000000,
+	844800000, 921600000, 998400000,
+};
+
+/* The original TX1 speedo-2 DVFS table permits 998.4 MHz at no more than
+ * 1150 mV. Until its CVB curve is ported, use that conservative rail voltage
+ * above the known working 217.6 MHz point. Never raise the PLL first.
+ */
+unsigned long tx1_gpu_get_rate(void)
+{
+	return tx1_gpcclk ? clk_get_rate(tx1_gpcclk) : 0;
+}
+
+int tx1_gpu_set_rate(struct device *dev, unsigned long rate)
+{
+	int old_uv, target_uv, err;
+
+	if (!tx1_gpcclk)
+		return -ENODEV;
+	if (rate > 998400000UL)
+		return -ERANGE;
+
+	mutex_lock(&tx1_power.rate_lock);
+	old_uv = regulator_get_voltage(tx1_power.vdd);
+	if (old_uv < 0) {
+		err = old_uv;
+		goto out;
+	}
+	target_uv = rate > 217600000UL ? 1150000 : 710000;
+	if (target_uv > old_uv) {
+		err = regulator_set_voltage(tx1_power.vdd,
+					 target_uv, target_uv);
+		if (err)
+			goto out;
+		usleep_range(200, 250);
+	}
+
+	err = clk_set_rate(tx1_gpcclk, rate);
+	if (err) {
+		if (target_uv > old_uv)
+			regulator_set_voltage(tx1_power.vdd, old_uv, old_uv);
+		goto out;
+	}
+	if (target_uv < old_uv)
+		err = regulator_set_voltage(tx1_power.vdd,
+					 target_uv, target_uv);
+out:
+	mutex_unlock(&tx1_power.rate_lock);
+	return err;
+}
 
