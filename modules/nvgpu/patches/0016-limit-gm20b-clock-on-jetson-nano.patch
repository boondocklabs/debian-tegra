+/* The P3448-0000 Nano BSP limits the GPCPLL to 921.6 MHz. */
+static unsigned int tegra210_gpu_num_freqs(void)
+{
+	if (of_machine_is_compatible("nvidia,p3450-0000"))
+		return ARRAY_SIZE(tx1_gpu_freqs) - 1;
+
+	return ARRAY_SIZE(tx1_gpu_freqs);
+}
 
