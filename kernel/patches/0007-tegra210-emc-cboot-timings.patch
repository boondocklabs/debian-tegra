+static const u32 tx1_emc_rates[] = { 408000, 665600, 800000 };
+
+static int tegra210_emc_read_cboot_timing(struct tegra210_emc *emc,
+					struct tegra210_emc_timing *timing,
+					const void *fdt, int node)
+{
+	const char *name;
+	const __be32 *cells;
+	unsigned int i;
+	int size;
+
+#define READ_STRING(field, property) do { \
+	name = fdt_getprop(fdt, node, property, &size); \
+	if (!name || size < 1 || size > sizeof(timing->field) || \
+	    strnlen(name, size) != size - 1) \
+		return dev_err_probe(emc->dev, -EINVAL, "bad EMC %s\n", property); \
+	memcpy((void *)timing->field, name, size); \
+} while (0)
+#define READ_U32(field, property) do { \
+	cells = fdt_getprop(fdt, node, property, &size); \
+	if (!cells || size != sizeof(*cells)) \
+		return dev_err_probe(emc->dev, -EINVAL, "bad EMC %s\n", property); \
+	timing->field = be32_to_cpup(cells); \
+} while (0)
+#define READ_ARRAY(field, property, count) do { \
+	if (count > ARRAY_SIZE(timing->field)) \
+		return dev_err_probe(emc->dev, -EINVAL, "too many EMC %s cells\n", property); \
+	cells = fdt_getprop(fdt, node, property, &size); \
+	if (!cells || size != count * sizeof(*cells)) \
+		return dev_err_probe(emc->dev, -EINVAL, "bad EMC %s\n", property); \
+	for (i = 0; i < count; i++) \
+		timing->field[i] = be32_to_cpup(cells + i); \
+} while (0)
+
+	READ_STRING(clock_src, "nvidia,source");
+	READ_STRING(dvfs_ver, "nvidia,dvfs-version");
+
+	READ_U32(revision, "nvidia,revision");
+	READ_U32(rate, "clock-frequency");
+	READ_U32(min_volt, "nvidia,emc-min-mv");
+	READ_U32(gpu_min_volt, "nvidia,gk20a-min-mv");
+	READ_U32(clk_src_emc, "nvidia,src-sel-reg");
+	READ_U32(num_burst, "nvidia,burst-regs-num");
+	READ_U32(emc_cfg_2, "nvidia,emc-cfg-2");
+	READ_U32(emc_sel_dpd_ctrl, "nvidia,emc-sel-dpd-ctrl");
+	READ_U32(emc_auto_cal_config, "nvidia,emc-auto-cal-config");
+	READ_U32(emc_auto_cal_config2, "nvidia,emc-auto-cal-config2");
+	READ_U32(emc_auto_cal_config3, "nvidia,emc-auto-cal-config3");
+	READ_U32(latency, "nvidia,emc-clock-latency-change");
+	READ_ARRAY(burst_regs, "nvidia,emc-registers", timing->num_burst);
+	READ_U32(needs_training, "nvidia,needs-training");
+	READ_U32(trained, "nvidia,trained");
+
+	if (timing->revision >= 0x6) {
+		READ_U32(periodic_training, "nvidia,periodic_training");
+		READ_U32(trained_dram_clktree[C0D0U0], "nvidia,trained_dram_clktree_c0d0u0");
+		READ_U32(trained_dram_clktree[C0D0U1], "nvidia,trained_dram_clktree_c0d0u1");
+		READ_U32(trained_dram_clktree[C0D1U0], "nvidia,trained_dram_clktree_c0d1u0");
+		READ_U32(trained_dram_clktree[C0D1U1], "nvidia,trained_dram_clktree_c0d1u1");
+		READ_U32(trained_dram_clktree[C1D0U0], "nvidia,trained_dram_clktree_c1d0u0");
+		READ_U32(trained_dram_clktree[C1D0U1], "nvidia,trained_dram_clktree_c1d0u1");
+		READ_U32(trained_dram_clktree[C1D1U0], "nvidia,trained_dram_clktree_c1d1u0");
+		READ_U32(trained_dram_clktree[C1D1U1], "nvidia,trained_dram_clktree_c1d1u1");
+		READ_U32(current_dram_clktree[C0D0U0], "nvidia,current_dram_clktree_c0d0u0");
+		READ_U32(current_dram_clktree[C0D0U1], "nvidia,current_dram_clktree_c0d0u1");
+		READ_U32(current_dram_clktree[C0D1U0], "nvidia,current_dram_clktree_c0d1u0");
+		READ_U32(current_dram_clktree[C0D1U1], "nvidia,current_dram_clktree_c0d1u1");
+		READ_U32(current_dram_clktree[C1D0U0], "nvidia,current_dram_clktree_c1d0u0");
+		READ_U32(current_dram_clktree[C1D0U1], "nvidia,current_dram_clktree_c1d0u1");
+		READ_U32(current_dram_clktree[C1D1U0], "nvidia,current_dram_clktree_c1d1u0");
+		READ_U32(current_dram_clktree[C1D1U1], "nvidia,current_dram_clktree_c1d1u1");
+		READ_U32(run_clocks, "nvidia,run_clocks");
+		READ_U32(tree_margin, "nvidia,tree_margin");
+	}
+
+	READ_U32(num_burst_per_ch, "nvidia,burst-regs-per-ch-num");
+	READ_U32(num_trim, "nvidia,trim-regs-num");
+	READ_U32(num_trim_per_ch, "nvidia,trim-regs-per-ch-num");
+	READ_U32(num_mc_regs, "nvidia,burst-mc-regs-num");
+	READ_U32(num_up_down, "nvidia,la-scale-regs-num");
+	READ_U32(vref_num, "nvidia,vref-regs-num");
+	READ_U32(dram_timing_num, "nvidia,dram-timing-regs-num");
+	READ_U32(min_mrs_wait, "nvidia,min-mrs-wait");
+	READ_U32(emc_mrw, "nvidia,emc-mrw");
+	READ_U32(emc_mrw2, "nvidia,emc-mrw2");
+	READ_U32(emc_mrw3, "nvidia,emc-mrw3");
+	READ_U32(emc_mrw4, "nvidia,emc-mrw4");
+	READ_U32(emc_mrw9, "nvidia,emc-mrw9");
+	READ_U32(emc_mrs, "nvidia,emc-mrs");
+	READ_U32(emc_emrs, "nvidia,emc-emrs");
+	READ_U32(emc_emrs2, "nvidia,emc-emrs2");
+	READ_U32(emc_auto_cal_config4, "nvidia,emc-auto-cal-config4");
+	READ_U32(emc_auto_cal_config5, "nvidia,emc-auto-cal-config5");
+	READ_U32(emc_auto_cal_config6, "nvidia,emc-auto-cal-config6");
+	READ_U32(emc_auto_cal_config7, "nvidia,emc-auto-cal-config7");
+	READ_U32(emc_auto_cal_config8, "nvidia,emc-auto-cal-config8");
+	READ_U32(emc_fdpd_ctrl_cmd_no_ramp, "nvidia,emc-fdpd-ctrl-cmd-no-ramp");
+	READ_U32(dll_clk_src, "nvidia,dll-clk-src");
+	READ_U32(clk_out_enb_x_0_clk_enb_emc_dll, "nvidia,clk-out-enb-x-0-clk-enb-emc-dll");
+
+	if (timing->revision >= 0x7)
+		READ_ARRAY(ptfv_list, "nvidia,ptfv", ARRAY_SIZE(timing->ptfv_list));
+
+	READ_ARRAY(burst_reg_per_ch, "nvidia,emc-burst-regs-per-ch",
+			timing->num_burst_per_ch);
+	READ_ARRAY(shadow_regs_ca_train, "nvidia,emc-shadow-regs-ca-train",
+			timing->num_burst);
+	READ_ARRAY(shadow_regs_quse_train, "nvidia,emc-shadow-regs-quse-train",
+			timing->num_burst);
+	READ_ARRAY(shadow_regs_rdwr_train, "nvidia,emc-shadow-regs-rdwr-train",
+			timing->num_burst);
+	READ_ARRAY(trim_regs, "nvidia,emc-trim-regs", timing->num_trim);
+	READ_ARRAY(trim_perch_regs, "nvidia,emc-trim-regs-per-ch", timing->num_trim_per_ch);
+	READ_ARRAY(vref_perch_regs, "nvidia,emc-vref-regs", timing->vref_num);
+	READ_ARRAY(dram_timings, "nvidia,emc-dram-timing-regs", timing->dram_timing_num);
+	READ_ARRAY(burst_mc_regs, "nvidia,emc-burst-mc-regs", timing->num_mc_regs);
+	READ_ARRAY(la_scale_regs, "nvidia,emc-la-scale-regs", timing->num_up_down);
+
+#undef READ_STRING
+#undef READ_U32
+#undef READ_ARRAY
+
+	if (timing->revision != 7 || !timing->trained ||
+	    timing->num_mc_regs <= MC_EMEM_ARB_MISC0_INDEX ||
+	    timing->min_volt > 1100)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int tegra210_emc_parse_cboot_fdt(struct tegra210_emc *emc, const void *fdt)
+{
+	const __be32 *value;
+	u32 ram_code = tegra_read_ram_code();
+	int controller, table, child, size, err;
+	unsigned int i;
+
+	if (ram_code != 0)
+		return -ENODEV;
+
+	controller = fdt_path_offset(fdt, "/external-memory-controller@7001b000");
+	if (controller < 0)
+		return -EINVAL;
+
+	fdt_for_each_subnode(table, fdt, controller) {
+		value = fdt_getprop(fdt, table, "nvidia,ram-code", &size);
+		if (value && size == sizeof(*value) && be32_to_cpup(value) == ram_code)
+			break;
+	}
+	if (table < 0)
+		return -ENOENT;
+
+	emc->num_timings = ARRAY_SIZE(tx1_emc_rates);
+	emc->nominal = devm_kcalloc(emc->dev, emc->num_timings, sizeof(*emc->nominal),
+				    GFP_KERNEL);
+	emc->derated = devm_kcalloc(emc->dev, emc->num_timings, sizeof(*emc->derated),
+				    GFP_KERNEL);
+	if (!emc->nominal || !emc->derated)
+		return -ENOMEM;
+
+	fdt_for_each_subnode(child, fdt, table) {
+		struct tegra210_emc_timing *timing;
+
+		value = fdt_getprop(fdt, child, "clock-frequency", &size);
+		if (!value || size != sizeof(*value))
+			continue;
+
+		for (i = 0; i < emc->num_timings; i++)
+			if (tx1_emc_rates[i] == be32_to_cpup(value))
+				break;
+		if (i == emc->num_timings)
+			continue;
+
+		if (!fdt_node_check_compatible(fdt, child, "nvidia,tegra21-emc-table"))
+			timing = &emc->nominal[i];
+		else if (!fdt_node_check_compatible(fdt, child, "nvidia,tegra21-emc-table-derated"))
+			timing = &emc->derated[i];
+		else
+			continue;
+
+		if (timing->rate)
+			return -EINVAL;
+
+		err = tegra210_emc_read_cboot_timing(emc, timing, fdt, child);
+		if (err)
+			return err;
+	}
+
+	for (i = 0; i < emc->num_timings; i++)
+		if (!emc->nominal[i].rate || !emc->derated[i].rate)
+			return -ENOENT;
+
+	return 0;
+}
+
+static int tegra210_emc_load_cboot_timings(struct tegra210_emc *emc)
+{
+	struct device_node *region;
+	struct reserved_mem *mem;
+	struct regulator *supply;
+	void *fdt;
+	unsigned int i, min_uv = 0;
+	int err;
+
+	region = of_parse_phandle(emc->dev->of_node, "nvidia,cboot-timing-region", 0);
+	if (!region)
+		return -ENODEV;
+
+	mem = of_reserved_mem_lookup(region);
+	of_node_put(region);
+	if (!mem)
+		return -EINVAL;
+
+	fdt = memremap(mem->base, mem->size, MEMREMAP_WB);
+	if (!fdt)
+		return -ENOMEM;
+
+	err = fdt_check_header(fdt);
+	if (!err && fdt_totalsize(fdt) <= mem->size)
+		err = tegra210_emc_parse_cboot_fdt(emc, fdt);
+	else
+		err = -EINVAL;
+	memunmap(fdt);
+	if (err)
+		return err;
+
+	for (i = 0; i < emc->num_timings; i++)
+		min_uv = max3(min_uv, emc->nominal[i].min_volt * 1000,
+			      emc->derated[i].min_volt * 1000);
+
+	supply = devm_regulator_get(emc->dev, "vdd-soc");
+	if (IS_ERR(supply))
+		return PTR_ERR(supply);
+
+	/* Keep the shared SoC rail at or above the highest required voltage. */
+	err = regulator_get_voltage(supply);
+	if (err < 0)
+		return err;
+	err = regulator_set_voltage(supply, max_t(unsigned int, err, min_uv), INT_MAX);
+	if (err)
+		return err;
+
+	dev_info(emc->dev, "loaded %u CBoot-trained RAM code 0 EMC timing pairs\n",
+		 emc->num_timings);
+	return 0;
+}
+
 static int tegra210_emc_validate_timings(struct tegra210_emc *emc,
 					 struct tegra210_emc_timing *timings,
 					 unsigned int num_timings)
